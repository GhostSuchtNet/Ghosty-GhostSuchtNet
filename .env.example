# Ghosty öffentliche API
PORT=3009
ALLOWED_ORIGINS=https://ghostsucht.net,https://www.ghostsucht.net

# Internes Legacy-/Tool-Backend
GHOSTY_LEGACY_PORT=3011

# Ghosty Medium = Qwen 3.6 35B-A3B auf llama.cpp
# LOCAL_AI_* bleibt zusätzlich für server-before-auth.js bestehen.
LOCAL_AI_URL=http://127.0.0.1:8089
LOCAL_AI_MODEL=ghosty-medium
GHOSTY_MEDIUM_URL=http://127.0.0.1:8089
GHOSTY_MEDIUM_MODEL=ghosty-medium

# Ghosty Lite = Qwen 3.5 4B auf llama.cpp
GHOSTY_LITE_URL=http://127.0.0.1:8091
GHOSTY_LITE_MODEL=ghosty-lite

# Standardmäßig passen 2 aktive Requests zu --parallel 2 pro llama.cpp-Server.
GHOSTY_LOCAL_CONCURRENCY=2

# Ghosty High ist vorbereitet, aber noch nicht aktiviert.
# Sobald später ein größeres Modell läuft, URL/Modell hier setzen.
# GHOSTY_HIGH_URL=http://127.0.0.1:8092
# GHOSTY_HIGH_MODEL=ghosty-high
# GHOSTY_HIGH_VISION=false
# GHOSTY_HIGH_CONCURRENCY=1

# Cloud-Keys niemals committen. Nur lokal in /opt/ai-gateway/.env eintragen.
GEMINI_API_KEY=
GROQ_API_KEY=

# Datenbankwerte ebenfalls nur lokal in der echten .env pflegen.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ghosty
DB_USER=ghosty_app
DB_PASSWORD=
ACCESS_CODE_PEPPER=
